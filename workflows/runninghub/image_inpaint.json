    },
    {
      "param_name": "negative_prompt",
      "node_id": "3",
      "input_field": "text",
      "node_class_type": "CLIPTextEncode"
    },
    {
      "param_name": "image",
      "node_id": "4",
      "input_field": "image",
      "node_class_type": "LoadImage"
    },
    {
      "param_name": "mask",
      "node_id": "5",
      "input_field": "image",
      "node_class_type": "LoadImageMask"
    },
    {
      "param_name": "denoise",
      "node_id": "7",
      "input_field": "denoise",
      "node_class_type": "KSampler"
    }
  ]
